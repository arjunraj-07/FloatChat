# Python virtual environment (kept on disk, never tracked)
venv/
.venv/
env/

# Python bytecode / build artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Environment files and credentials (never commit)
.env
.env.*
!.env.example
*.key
*.pem

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Node artefacts (the frontend repo has its own ignore rules too)
node_modules/
.next/

# Locally derived reference caches. The cached WOA extracts under
# data/reference/ are small and ARE tracked on purpose so that the offline
# tests and the evidence panel are reproducible without network access.

# Local account database (Argon2id password hashes and server-side
# sessions). Never committed: it holds real credentials for whoever has
# registered on this machine. Path is configurable via FLOATCHAT_AUTH_DB.
data/accounts/

# Refreshed Argo snapshots are data, not source: each is downloaded
# by scripts/refresh_argo.ps1 and reproducible from its recorded
# provenance. The original January 2024 extract stays tracked.
scripts/data_feasibility/data/snapshots/
